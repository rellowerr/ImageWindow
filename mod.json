{
  "geode": "5.11.1",
  "gd": {
    "win": "2.2081"
  },
  "version": "v1.0.2",
  "id": "low.image_window",
  "name": "ImageWindow",
  "developer": "Rellower",
  "description": "Display custom images, photos, and references on your screen while playing levels or in the editor. Features an image gallery, drag mode, scale, opacity, and HUD controls.",
  "repository": "https://github.com/rellowerr/ImageWindow",
  "links": {
    "community": "https://discord.gg/geode",
    "source": "https://github.com/rellowerr/ImageWindow"
  },
  "tags": [
    "utility",
    "customization",
    "gameplay"
  ],
  "settings": {
    "enabled": {
      "name": "Enable Mod",
      "description": "Toggles the image overlay on or off.",
      "type": "bool",
      "default": true
    },
    "toggle-keybind": {
      "name": "Toggle Keybind",
      "description": "Keybind to quickly show or hide the image overlay (Default: F8).",
      "type": "keybind",
      "default": "F8",
      "category": "universal"
    },
    "scale": {
      "name": "Scale",
      "description": "Image size (0.1x to 3.0x).",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 3.0,
      "control": {
        "slider": true
      }
    },
    "opacity": {
      "name": "Opacity",
      "description": "Image opacity (5% to 100%).",
      "type": "float",
      "default": 1.0,
      "min": 0.05,
      "max": 1.0,
      "control": {
        "slider": true
      }
    },
    "rotation": {
      "name": "Rotation",
      "description": "Rotation angle in degrees (0° - 360°).",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 360.0,
      "control": {
        "slider": true
      }
    },
    "pos-x": {
      "name": "Position X",
      "description": "Horizontal position on screen (0.0 to 1.0).",
      "type": "float",
      "default": 0.85,
      "min": 0.0,
      "max": 1.0
    },
    "pos-y": {
      "name": "Position Y",
      "description": "Vertical position on screen (0.0 to 1.0).",
      "type": "float",
      "default": 0.85,
      "min": 0.0,
      "max": 1.0
    },
    "flip-x": {
      "name": "Flip Horizontal",
      "description": "Mirror the image horizontally.",
      "type": "bool",
      "default": false
    },
    "flip-y": {
      "name": "Flip Vertical",
      "description": "Mirror the image vertically.",
      "type": "bool",
      "default": false
    },
    "show-frame": {
      "name": "HUD Frame",
      "description": "Display a sleek dark window frame behind the image.",
      "type": "bool",
      "default": false
    },
    "hide-on-pause": {
      "name": "Hide on Pause",
      "description": "Hide image when pause menu is opened.",
      "type": "bool",
      "default": false
    },
    "hide-on-death": {
      "name": "Hide on Death",
      "description": "Hide image when the player dies.",
      "type": "bool",
      "default": false
    },
    "practice-only": {
      "name": "Practice Mode Only",
      "description": "Show image only in practice mode.",
      "type": "bool",
      "default": false
    },
    "show-in-editor": {
      "name": "Show in Editor",
      "description": "Display image in level editor for art references.",
      "type": "bool",
      "default": false
    },
    "z-order": {
      "name": "Z-Order Layer",
      "description": "0: Behind level, 1: Under UI, 2: Over UI (HUD).",
      "type": "int",
      "default": 2,
      "min": 0,
      "max": 2
    }
  }
}
